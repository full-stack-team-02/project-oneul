# 이 파일을 복사해 server/.env 로 만들고 값을 채워주세요. (Render에서는 Environment 탭에 같은 키로 입력)

# MongoDB 접속 주소 (Atlas: Network Access에 0.0.0.0/0 허용 필요)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/

# JWT 서명 키 (아무도 모르는 긴 랜덤 문자열)
SECRET_KEY=

# 서버 포트 (Render는 자동으로 넣어주므로 Render에는 입력하지 않아도 됨)
PORT=8000

# production 이면 MONGO_URI, SECRET_KEY, CLOUDINARY_URL이 없을 때 서버가 시작되지 않음
NODE_ENV=development

# 프로필 이미지 저장소. 값이 있으면 Cloudinary, 비워두면 server/images/profile 에 저장 (개발은 비워두기)
# Cloudinary 대시보드의 "API environment variable" 값을 그대로 복사
CLOUDINARY_URL=

# 이 서버의 공개 주소 (프로필 이미지 URL 생성용). 예: https://oneul-server.onrender.com
REACT_APP_API_URL=
